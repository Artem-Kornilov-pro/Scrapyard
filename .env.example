# MongoDB
MONGO_URI=mongodb://mongodb:27017
DB_NAME=scrapyard

# Redis
REDIS_URL=redis://redis:6379/0

# API
API_HOST=0.0.0.0
API_PORT=8000

# Debug
DEBUG=false

# Security — leave API_KEY empty to disable auth (local dev only).
# Set it in production: every /api/v1 request must then send X-API-Key.
API_KEY=
RATE_LIMIT_PER_MINUTE=120

# Scraping etiquette
SCRAPER_USER_AGENT=ScrapyardBot/1.0 (+https://github.com/Artem-Kornilov-pro/scrapyard)
RESPECT_ROBOTS_TXT=true
DOMAIN_THROTTLE_SECONDS=2.0

# How long the API waits for a worker to finish a /dry-run before
# giving up and returning 504.
DRY_RUN_TIMEOUT_SECONDS=30

# Comma-separated proxy URLs, e.g. "http://user:pass@p1:8080,http://p2:8080".
# Each domain is deterministically pinned to one proxy from the pool.
# Empty disables proxying — scrapes go out directly.
PROXY_URLS=

# Circuit breaker: after this many consecutive 403/429 responses from a
# domain, scrapes to it are deferred for the cooldown period instead of
# retried immediately.
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_COOLDOWN_SECONDS=300

# OpenTelemetry tracing across api -> Celery -> MongoDB/Redis, exported to
# the bundled Jaeger (http://localhost:16686). Off by default outside
# docker-compose since there's no collector to send spans to.
ENABLE_TRACING=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317

# Grafana — default is fine for local; change in production!
GRAFANA_PASSWORD=admin