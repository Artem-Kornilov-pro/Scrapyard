FROM python:3.12-slim-bookworm

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Установка системных зависимостей для Playwright
RUN apt-get update && apt-get install -y --no-install-recommends \
    fonts-unifont \
    fonts-freefont-ttf \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Установка системных зависимостей браузера (нужны права root).
# Playwright 1.49 не знает Debian trixie (python:3.12-slim с некоторого
# момента указывает на неё) и падает на несуществующих именах пакетов,
# поэтому база явно закреплена на bookworm, где install-deps проверенно
# работает. Без `|| true`, чтобы сборка падала, а не давала воркер с
# нерабочим браузером.
RUN playwright install-deps chromium

RUN useradd --create-home --uid 1000 appuser && chown appuser:appuser /app
COPY --chown=appuser:appuser . .
USER appuser

# Браузер ставим уже под непривилегированным пользователем, чтобы
# кэш попал в его домашний каталог, а не в /root
RUN playwright install chromium

CMD ["celery", "-A", "worker.celery_app", "worker", "--loglevel=info"]