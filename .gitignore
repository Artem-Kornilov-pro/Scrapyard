# Создаем .gitignore
cat > .gitignore << 'EOF'
# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/
*.egg

# Virtual environment
venv/
env/
.venv/

# Environment variables
.env

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Database
*.db
*.sqlite3

# Docker
.docker/

# Node (web/)
node_modules/
*.local
*.tsbuildinfo

# Coverage
htmlcov/
.coverage
.coverage.*
coverage.xml
EOF